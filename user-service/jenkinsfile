pipeline {

    agent any

    stages {

        stage('Git Pull') {
            steps {
                echo 'Pulling Code'
            }
        }

        stage('Docker Build') {
    steps {
        dir('user-service') {
            sh 'docker build -t banking-user-service:v1 .'
        }
    }
}
