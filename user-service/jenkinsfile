pipeline {

    agent any

    stages {

        stage('Git Pull') {
            steps {
                echo 'Pulling Code'
            }
        }

        stage('Docker Build') {
    steps {
        dir('user-service') {
            sh 'docker build -t banking-user-service:v1 .'
        }
    }
}
        
        stage('Minikube Load') {
            steps {
                sh 'minikube image load banking-user-service:v1'
            }
        }

        stage('Kubernetes Deploy') {
            steps {
                sh 'kubectl apply -f kubernetes/deployment.yaml'
                sh 'kubectl apply -f kubernetes/service.yaml'
            }
        }
    }
}